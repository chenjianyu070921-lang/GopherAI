#!/usr/bin/env bash
# 复制本文件为 local_env.sh 后填入真实密钥。local_env.sh 不会被提交。

# 火山方舟（普通聊天），控制台获取：https://console.volcengine.com/ark
export OPENAI_API_KEY="ark-xxxxxxxxxxxxxxxx"

# 阿里云百炼（RAG 知识库 embedding + chat），申请：https://bailian.console.aliyun.com/?apiKey=1
export DASHSCOPE_API_KEY="sk-xxxxxxxxxxxxxxxx"

# JWT 签名密钥（建议用：openssl rand -hex 32 生成）
export JWT_KEY="xxxxxxxxxxxxxxxx"

# QQ 邮箱 SMTP 授权码（注册发信）
export EMAIL_AUTH_CODE="xxxxxxxxxxxxxxxx"
